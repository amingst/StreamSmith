// Application icon, embedded into StreamSmith.exe via `odin build -resource:`.
// Resource ID 1 is also loaded at runtime for the window class (see platform.odin).
1 ICON "streamsmith.ico"

// Version info. Keep FILEVERSION/PRODUCTVERSION and the matching strings in sync
// with APP_VERSION in src/version.odin.
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Andrew Mingst"
            VALUE "FileDescription",  "StreamSmith - live streaming and recording"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "StreamSmith"
            VALUE "OriginalFilename", "StreamSmith.exe"
            VALUE "ProductName",      "StreamSmith"
            VALUE "ProductVersion",   "v0.1.0-alpha"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Andrew Mingst"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
